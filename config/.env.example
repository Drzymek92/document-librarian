# Add required environment variables here

# LLM API (any OpenAI-compatible gateway) — used for image transcription & enrichment
LLM_BASE_URL="https://api.openai.com/v1/"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=

# Librarian effort tier: low (economical, default) | high (richer enrichment)
LIBRARIAN_EFFORT=low

# Google Drive source (optional) — default folder to scan; can also be passed on the CLI.
# Folder ID is the last path segment of the folder URL: .../folders/<ID>
GDRIVE_SOURCE_FOLDER_ID=
